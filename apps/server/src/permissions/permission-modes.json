    "careful": {
      "title": "Careful",
      "summary": "Asks before every file change and every command. Reading and searching run freely."
    },
    "normal": {
      "title": "Normal",
      "summary": "Asks only before risky actions: recursive deletes, sudo, git push or hard resets, changes outside the project, reading secrets, piping downloads into a shell, publishing packages."
    },
    "auto": {
      "title": "Auto",
      "summary": "Never asks. The agent runs everything it decides to run."
    }
  },
